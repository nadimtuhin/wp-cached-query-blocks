{
	"name": "nadimtuhin/cached-query-blocks",
	"description": "Query blocks whose rendered HTML is cached in the object cache and invalidated when content changes.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"mockery/mockery": "^1.6",
		"phpunit/phpunit": "^10.5",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"autoload": {
		"psr-4": {
			"CachedQueryBlocks\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"CachedQueryBlocks\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.1.0"
		},
		"sort-packages": true
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs"
	}
}
