<?xml version="1.0"?>
<ruleset name="Cached Query Blocks">
	<file>cached-query-blocks.php</file>
	<file>src</file>
	<file>blocks</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra">
		<!-- Class files follow PSR-4 names so Composer can autoload them. -->
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="cached-query-blocks"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="CachedQueryBlocks"/>
				<element value="cached_query_blocks"/>
			</property>
		</properties>
	</rule>
</ruleset>
